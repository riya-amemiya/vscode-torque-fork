{
  "name": "vscode-torque-fork",
  "displayName": "V8 Torque Language Support Fork",
  "version": "1.1.0",
  "description": "Syntax highlighting and language server for the V8 Torque programming language",
  "categories": [
    "Programming Languages"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/riya-amemiya/vscode-torque-fork.git"
  },
  "publisher": "riya-amemiya",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "rolldown -c",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "rolldown -c --minify",
    "watch": "rolldown -c --watch"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/vscode": "1.136.0",
    "@vscode/vsce": "3.9.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "rolldown": "1.2.7",
    "typescript": "7.0.2"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Torque",
      "properties": {
        "torque.ls.executable": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to the torque language server executable (absolute)"
        },
        "torque.ls.logging": {
          "type": "boolean",
          "default": false,
          "description": "Enable language server diagnostics output to log file"
        },
        "torque.ls.logfile": {
          "type": "string",
          "default": "torque-log.txt",
          "description": "Target file for language server logging output"
        },
        "torque.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the Torque language server from VSCode."
        }
      }
    },
    "languages": [
      {
        "id": "torque",
        "aliases": [
          "Torque",
          "torque"
        ],
        "extensions": [
          ".tq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "torque",
        "scopeName": "source.torque",
        "path": "./syntaxes/torque.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:**/*.tq"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "v8-logo.png",
  "engines": {
    "vscode": "^1.136.0"
  }
}
