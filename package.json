{
  "name": "vscode-torque-fork",
  "displayName": "V8 Torque Language Support Fork",
  "version": "1.4.1",
  "description": "Syntax highlighting, go-to-definition, completions, and a WASM Torque compiler for V8 Torque",
  "categories": [
    "Programming Languages"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Riya Amemiya",
    "url": "https://github.com/riya-amemiya"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/riya-amemiya/vscode-torque-fork.git"
  },
  "publisher": "riya-amemiya",
  "main": "./dist/extension.js",
  "scripts": {
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown -p torque-compiler && bun scripts/copy-wasm.ts",
    "bundle": "rolldown -c",
    "compile": "bun run build:wasm && bun run bundle",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "package": "vsce package --no-dependencies",
    "test": "bun test src",
    "test:compiler": "cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "bun run build:wasm && rolldown -c --minify",
    "watch": "rolldown -c --watch"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "4.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "rolldown": "1.2.9",
    "typescript": "7.0.2"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Torque",
      "properties": {
        "torque.ls.executable": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to the torque language server executable (absolute)"
        },
        "torque.ls.logging": {
          "type": "boolean",
          "default": false,
          "description": "Enable language server diagnostics output to log file"
        },
        "torque.ls.logfile": {
          "type": "string",
          "default": "torque-log.txt",
          "description": "Target file for language server logging output"
        },
        "torque.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the Torque language server from VSCode."
        }
      }
    },
    "languages": [
      {
        "id": "torque",
        "aliases": [
          "Torque",
          "torque"
        ],
        "extensions": [
          ".tq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "torque",
        "scopeName": "source.torque",
        "path": "./syntaxes/torque.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "torque",
        "scopes": {
          "type": [
            "entity.name.type.torque"
          ],
          "type.defaultLibrary": [
            "support.type.builtin.torque"
          ],
          "variable": [
            "variable.other.readwrite.torque"
          ],
          "variable.readonly": [
            "variable.other.constant.torque"
          ],
          "label": [
            "entity.name.label.torque",
            "entity.name.function.torque"
          ],
          "function": [
            "entity.name.function.torque"
          ],
          "macro": [
            "entity.name.function.macro.torque",
            "entity.name.function.torque"
          ],
          "property": [
            "variable.other.property.torque"
          ],
          "namespace": [
            "entity.name.namespace.torque"
          ],
          "class": [
            "entity.name.type.class.torque"
          ],
          "struct": [
            "entity.name.type.struct.torque"
          ],
          "enum": [
            "entity.name.type.enum.torque"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[torque]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "variable.readonly:torque": {
            "fontStyle": "italic"
          },
          "label:torque": {
            "fontStyle": "bold"
          }
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:torque",
    "workspaceContains:**/*.tq"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "v8-logo.png",
  "engines": {
    "vscode": "^1.125.0"
  }
}
